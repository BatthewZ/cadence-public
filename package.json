{
  "name": "cadence",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"vite\" \"wrangler dev\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cadence_au --local",
    "db:migrate:remote": "wrangler d1 migrations apply cadence_au --remote",
    "typecheck": "concurrently -n backend,web,tests,eslint -c blue,green,yellow,red \"bun run typecheck:backend\" \"bun run typecheck:web\" \"bun run typecheck:tests\" \"bun run lint:fix\"",
    "typecheck:ci": "concurrently -n backend,web,tests,eslint -c blue,green,yellow,red \"bun run typecheck:backend\" \"bun run typecheck:web\" \"bun run typecheck:tests\" \"bun run lint\"",
    "ci": "concurrently -n types:backend,types:web,types:tests,lint,test,build -c blue,green,yellow,red,cyan,magenta \"bun run typecheck:backend\" \"bun run typecheck:web\" \"bun run typecheck:tests\" \"bun run lint\" \"bun run test\" \"bun run build\"",
    "lint": "eslint src/",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write ./src",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --project api",
    "test:unit": "vitest run --project unit",
    "test:web": "vitest run --project web",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@hono/zod-validator": "^0.7.6",
    "@tanstack/react-query": "^5.95.2",
    "better-auth": "^1.5.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "hono": "4.12.9",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsdom": "^28.1.0",
    "miniflare": "^4.20260317.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "7.3.1",
    "vitest": "^4.1.2",
    "wrangler": "~4.77.0"
  }
}
