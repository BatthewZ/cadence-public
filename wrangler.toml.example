name = "cadence"
main = "src/api/index.ts"
compatibility_date = "2025-01-13"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[assets]
directory = "./dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = true

[[d1_databases]]
binding = "DB"
database_name = "your-database-name"
database_id = "your-database-id"

# Optional: R2 storage for file uploads
# [[r2_buckets]]
# binding = "STORAGE"
# bucket_name = "your-bucket-name"

# Optional: cron triggers for scheduled tasks
# [triggers]
# crons = ["*/5 * * * *"]

# Optional: custom domain
# [[routes]]
# pattern = "your-domain.com"
# custom_domain = true

# Optional: Analytics Engine. 
# This requires setup in the Cloudflare dashboard: Storage & databases > Analytics Engine > Enable > Create Dataset
# [[analytics_engine_datasets]]
# binding = "ANALYTICS"
# dataset = "cadence_telemetry"

# Optional: Worker Logs and Traces
# [observability]
# [observability.logs]
# enabled = true
# invocation_logs = true

# [observability.traces]
# enabled = true

