# === Required ===

# Signing secret for auth tokens. Must be a strong random string (32+ characters).
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the application. Used for auth callbacks and CORS.
# Local dev: http://localhost:8787
# Production: https://your-app.your-domain.com
BETTER_AUTH_URL=http://localhost:8787

# === Optional ===

# Comma-separated list of additional trusted origins for CORS.
# TRUSTED_ORIGINS=https://other-domain.com

# Resend API key for email delivery (auth emails, invitations).
# Without this, emails are logged to the console instead of sent.
# RESEND_API_KEY=

# Sender address for emails. Defaults to noreply@example.com.
# EMAIL_FROM=noreply@yourdomain.com

# Note: DB and STORAGE bindings are configured in wrangler.toml, not here.
# STORAGE (R2) is optional — upload endpoints return 503 without it.

# Optional: Unsplash Integration
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_SECRET_KEY=